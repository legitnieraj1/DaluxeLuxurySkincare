{
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/admin/:path*",
            "destination": "https://daluxe-luxury-admin-git-main-nierajs-projects.vercel.app/admin/:path*"
        },
        {
            "source": "/api/:path*",
            "destination": "https://daluxe-luxury-admin-git-main-nierajs-projects.vercel.app/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
